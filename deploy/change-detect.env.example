# /etc/change-detect.env  (root-only, never commit the real one)

# Web UI port
WEB_PORT=8130
# Extra CLI args, e.g. "--simulate" to preload the synthetic demo, or "--no-cot"
CHANGE_DETECT_ARGS=

# ATAK / TAK server (plain CoT XML over TCP)
TAK_HOST=127.0.0.1
TAK_PORT=8087
COT_ENABLED=1

# Mesh text via a mesh bridge service (MQTT meshbus/tx) and the isrkit heartbeat.
# On the Pi, guest/guest works (loopback). From a laptop, use the isrkit user (see deploy/station.env.example).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
MESH_ENABLED=1
HEARTBEAT=1
# Heartbeat "host" name; default is the lowercased short hostname
# ISR_HOST=isr-pi
# OP (sensor) position, used for ATAK/mesh when the images have no GPS and none is typed in.
# Leave unset rather than 0,0: with no position the marker is refused, never sent at 0,0.
# SENSOR_LAT=
# SENSOR_LON=
# URL advertised in the heartbeat (default http://<this host's IP>:WEB_PORT/)
# PUBLIC_URL=http://isr-pi.local:8130/   (default: http://<short hostname>.local:WEB_PORT/)

# pi = downscale stills to 1600 px for speed; laptop = full resolution
CHANGE_DETECT_PROFILE=pi

# AI suggestions: auto = local OpenAI-compatible VLM (Ollama) -> Gemini (if key) -> off
VLM_BACKEND=auto
# Bare Ollama base URL, no path (the tool appends /v1/chat/completions). The HQ Mac runs Ollama.
VLM_URL=http://isr-hq.local:11434
VLM_MODEL=qwen3-vl:8b-instruct
# Optional cloud AI suggestions. Leave GEMINI_API_KEY empty for fully offline operation.
# Cloud mode SENDS IMAGE CROPS TO GOOGLE: demo footage only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# YOLO: auto = ultralytics on GPU/MPS if installed (laptop), else ONNX via OpenCV (Pi), else off
YOLO_BACKEND=auto
# Optional YOLO nano ONNX model for labels (default /var/lib/change-detect/models/yolo11n.onnx)
# YOLO_MODEL=/var/lib/change-detect/models/yolo11n.onnx

# Insta360 ONE dual-fisheye unwarp: usable field of view per lens (degrees)
# FISHEYE_FOV_DEG=200

MAX_UPLOAD_MB=1024
# Where deploy/install.sh downloads yolo11n.onnx from, if it is not in the repo's models/ dir
# YOLO_ONNX_URL=
