# laptop.env: copy to the repo root as laptop.env (scripts/run-laptop.* do this on first run).
# Never commit the real file.

# The Pi hub: mDNS name from pi-platform. If .local does not resolve, use the Pi's fixed hotspot IP.
TAK_HOST=isr-pi.local
TAK_PORT=8087
MQTT_HOST=isr-pi.local
MQTT_PORT=1883
# RabbitMQ's guest account is loopback-only: remote tools use isrkit (password from the Pi's env file)
MQTT_USER=isrkit
MQTT_PASS=change-me

WEB_PORT=8130
CHANGE_DETECT_PROFILE=laptop
# Where reports go (default: ~/change-detect-data)
# CHANGE_DETECT_DATA_DIR=

# AI suggestions: Ollama on this Mac first, then Gemini if a key is set, else off
VLM_BACKEND=auto
VLM_URL=http://localhost:11434/v1
VLM_MODEL=qwen3-vl:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# YOLO via PyTorch: MPS/CUDA picks yolo11m, CPU picks yolo11n. Override with YOLO_WEIGHTS=yolo11l.pt
YOLO_BACKEND=auto
# YOLO_WEIGHTS=
