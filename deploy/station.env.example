# Reference for the Mac station config. The platform's laptop/start-mac.sh sources
# ~/.config/isr-kit/station.env and then runs scripts/run-laptop.sh, which reads the ENVIRONMENT only.
# These are the keys change-detect uses; the values shown are the defaults on a Mac.

TAK_HOST=isr-pi.local
TAK_PORT=8087
MQTT_HOST=isr-pi.local
MQTT_PORT=1883
MQTT_USER=isrkit
MQTT_PASS=            # required for the heartbeat/mesh from a Mac (isrkit password from the Pi)

WEB_PORT=8130
CHANGE_DETECT_PROFILE=laptop
# CHANGE_DETECT_DATA_DIR=$HOME/change-detect-data

# Bare Ollama base URL, no path (change-detect appends /v1/chat/completions itself)
VLM_BACKEND=auto
VLM_URL=http://isr-hq.local:11434
VLM_MODEL=qwen3-vl:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

YOLO_BACKEND=auto
# YOLO_WEIGHTS=yolo11m.pt
